{
	"schemaVersion": 1,
	"id": "force_mc",
	"version": "${version}",
	"name": "Force",
	"description": "Your coding agents, inside Minecraft. Press F12 to see and answer your Claude Code and OpenCode sessions without leaving the game. Needs Force (useforce.cc).",
	"authors": ["Force contributors"],
	"contact": {
		"homepage": "https://useforce.cc",
		"sources": "https://github.com/zalandemeter/force-minecraft",
		"issues": "https://github.com/zalandemeter/force-minecraft/issues"
	},
	"license": "MIT",
	"icon": "assets/force_mc/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["cc.useforce.mc.ForceClient"],
		"modmenu": ["cc.useforce.mc.ModMenuEntry"]
	},
	"mixins": [
		{"config": "force_mc.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
